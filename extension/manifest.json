{
  "manifest_version": 3,
  "name": "JobMatch AI — ATS Matcher & Resume Tailor",
  "version": "1.0.0",
  "description": "1-Click ATS scoring, skill-gap analysis, and tailored 1-page vector PDF download for LinkedIn, Naukri & career portals.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open JobMatch AI Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
